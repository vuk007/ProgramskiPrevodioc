	private void report_error(String message, SyntaxNode info) {
		errorDetected = true;
		errorCount++;
		StringBuilder msg = new StringBuilder(message);
		int line = (info == null) ? 0 : info.getLine();
		msg.append(" na liniji ").append(line);
		System.err.println(msg.toString());
	}
	
	
